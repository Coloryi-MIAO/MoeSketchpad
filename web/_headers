# MoeSketchpad Web hosting headers (Netlify / Cloudflare Pages syntax).
# Ensure .msp downloads are identified correctly and app assets are not cached
# across releases without revalidation.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/*.msp
  Content-Type: application/x-moesketchpad
  Content-Disposition: attachment
